# Monitor
MONITOR_PORT=8000
POLL_INTERVAL_SECONDS=300
FEED_URLS=https://ria.ru/export/rss2/archive/index.xml,https://tass.ru/rss/v2.xml,https://www.kommersant.ru/RSS/news.xml
HTTP_REQUEST_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=NewsPipelineMonitor/1.0 (+https://example.org)
DEDUP_DB_PATH=/data/seen.sqlite

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=news.incoming

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=news
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Worker
NER_MODEL=ru_core_news_sm
NER_MAX_CHARS=20000
WORKER_MAX_RETRIES=3

# Shared
STARTUP_RETRY_ATTEMPTS=10
STARTUP_RETRY_DELAY_SECONDS=3
LOG_LEVEL=INFO