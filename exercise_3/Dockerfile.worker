# syntax=docker/dockerfile:1

FROM python:3.12-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /bin/

COPY pyproject.toml uv.lock ./

# The ru_core_news_sm model is a locked dependency of the worker group,
# so it is installed at build time and never downloaded at container start.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --group worker --no-group dev

COPY src /app/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --group worker --no-group dev

RUN python -c "import spacy; spacy.load('ru_core_news_sm')"

CMD ["faststream", "run", "news_pipeline.worker.app:app"]
