{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "incident-mcp": {
        "type": "local",
        "command": ["uv", "run", "incident-mcp"],
        "cwd": ".",
        "timeout": {
          "startup": 15000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "incident-mcp_incident_acknowledge",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "incident-mcp_incident_create_summary",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
