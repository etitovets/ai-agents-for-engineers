# Copy to .env and adjust. .env is gitignored; never commit real credentials.
#
# Connection string for the incident stand, host side (Postgres is published on
# localhost:5433). The values below are the stand's own published local
# defaults, so `cp .env.example .env` works out of the box for local exercises.
#
# For anything beyond local use, point this at the read-only role documented in
# README.md ("Read-only database role"):
#   STAND_DATABASE_URL=postgresql://oncall_ro:CHANGE_ME@localhost:5433/oncall
STAND_DATABASE_URL=postgresql://oncall:oncall@localhost:5433/oncall

# --- Optional tuning (defaults shown) ---
# ONCALL_POOL_MIN_SIZE=1
# ONCALL_POOL_MAX_SIZE=5
# ONCALL_POOL_ACQUIRE_TIMEOUT=5.0
# ONCALL_DB_CONNECT_TIMEOUT=5.0
# ONCALL_STATEMENT_TIMEOUT_MS=5000
# ONCALL_RUNBOOKS_DIR=./lesson_4/runbooks
