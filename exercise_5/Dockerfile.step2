# Шаг 2: тот же Dockerfile, но базовый образ — slim вместо полного python:3.12.
# apt-пакеты, pip/uv, dev-зависимости и тесты пока остаются внутри образа.

FROM python:3.12-slim

ENV ADMIN_TOKEN=launch-control-dev-token
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    vim \
    curl \
    net-tools \
    procps

RUN pip install --upgrade pip
RUN pip install uv

WORKDIR /app

COPY . .

RUN uv pip install --system -r pyproject.toml --extra dev

RUN pytest -q

EXPOSE 8000

CMD uvicorn app.main:app --host 0.0.0.0 --port 8000
