# syntax=docker/dockerfile:1.7

# Шаг 4 (итоговый): в runtime не едут ни dev-зависимости, ни неиспользуемые
# pandas/numpy — их импортирует только офлайн-скрипт tools/analyze_launches.py.
# pyproject.toml не меняем: лишние пакеты исключаются на этапе установки.
# Плюс чистим образ от логов/кешей/служебных файлов (в т.ч. доставшихся от базового образа).

FROM ghcr.io/astral-sh/uv:0.13.7-python3.12-trixie-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Слой зависимостей пересобирается только при изменении pyproject.toml/uv.lock.
# --locked: сборка падает, если lock-файл разошёлся с pyproject.toml.
# --no-install-package: pandas/numpy остаются в lock-файле, но не ставятся в образ.
# После установки убираем байткод-кеш и служебные файлы venv: в runtime они не нужны.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project \
        --no-install-package pandas \
        --no-install-package numpy \
    && find /app/.venv -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /app/.venv -name '*.pyc' -delete \
    && rm -f /app/.venv/.lock /app/.venv/.gitignore /app/.venv/CACHEDIR.TAG

FROM python:3.12-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Пользователь приложения + зачистка логов, кешей и ненужных модулей stdlib,
# которые пришли с базовым образом.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && rm -rf /var/log/* /var/cache/apt/* /var/cache/debconf/* /var/lib/apt/lists/* \
    && rm -f /var/lib/dpkg/status-old /var/lib/dpkg/diversions-old \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
              /usr/local/lib/python3.12/idlelib \
              /usr/local/lib/python3.12/lib2to3 \
              /usr/local/lib/python3.12/turtledemo \
              /usr/local/lib/python3.12/tkinter \
              /usr/local/lib/python3.12/pydoc_data \
    && find /usr/local/lib/python3.12 -type d -name __pycache__ -empty -delete

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 app ./app

USER 10001

EXPOSE 8000

# curl/wget в runtime не ставим — healthcheck на стандартной библиотеке.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
